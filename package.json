{
  "name": "liquidation-guardian",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env guardian-server.mjs",
    "dashboard": "node --env-file-if-exists=.env guardian-server.mjs",
    "demo": "node guardian-cli.mjs demo",
    "analyze": "node guardian-cli.mjs analyze",
    "doctor": "node --env-file-if-exists=.env guardian-cli.mjs doctor",
    "start": "node --env-file-if-exists=.env start.mjs",
    "worker": "node --env-file-if-exists=.env worker.mjs",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=.local/mps-runtime.env agent-api.mjs",
    "test": "node --env-file-if-exists=.env --test *.test.mjs",
    "contract": "cd onchain && aiken check && aiken build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@lucid-evolution/lucid": "0.4.29",
    "ai": "7.0.127",
    "eve": "0.71.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "libsodium-wrappers-sumo": "0.7.15",
    "libsodium-sumo": "0.7.15"
  }
}
