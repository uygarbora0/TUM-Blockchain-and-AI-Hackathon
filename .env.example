ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
ZAI_CONTEXT_WINDOW_TOKENS=
BLOCKFROST_API_KEY_PREPROD=
EVE_PORT=21949
EVE_URL=http://127.0.0.1:21949
COWORKER_ID=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
AGENT_AUTHOR=

MPS_PORT=38127
MPS_URL=http://127.0.0.1:38127

# Only the one machine that serves customers sets this, to its own OS username (`whoami`).
# npm run worker refuses to start anywhere else, so tasks are never answered twice.
WORKER_OPERATOR=

AGENT_API_PORT=21950
PAID_TASKS_ENABLED=false

# Local simulation dashboard. No credentials are required for npm run dev.
GUARDIAN_PORT=3000
# Public-facing URL the agent points customers to in its result. Localhost works only on
# this machine; set to a public https URL (tunnel or deployment) for real customers.
DASHBOARD_URL=http://127.0.0.1:3000
# Public hostname (no scheme) of a tunnel to the dashboard, e.g. abc.trycloudflare.com. Set DASHBOARD_URL to https://<PUBLIC_HOST>.
PUBLIC_HOST=
